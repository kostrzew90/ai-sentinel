# DATABASE_URL is for running on the host (db is published on 5440); the app container gets its own from compose.
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5440/sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
LLM_PROVIDER=scripted-compromised
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
APPROVER_TOKEN=change-me
